# Copy to .env and generate secrets; do not commit .env.
DEBUG=false
SECRET_KEY=
ALLOWED_HOSTS=work.example.com
CSRF_TRUSTED_ORIGINS=https://work.example.com
DB_ENGINE=postgres
POSTGRES_DB=projectwork
POSTGRES_USER=projectwork
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Use your real domain for automatic HTTPS. For local Compose only, use http://localhost
SITE_ADDRESS=work.example.com

# Microsoft Entra ID: single-tenant OpenID Connect (no passwords in production)
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SSO_ADMIN_EMAIL=
# Must remain false in production. Even true is ignored when DEBUG=false.
ALLOW_LOCAL_LOGIN=false
